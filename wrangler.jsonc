// Cloudflare Workers 배포 설정. 사용법은 README.md 의 "Cloudflare 에 무료로 올리기"를 보세요.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 주소가 https://submit-link.<계정 이름>.workers.dev 가 됩니다.
  "name": "submit-link",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // 정적 파일(/assets/...)은 Cloudflare 가 직접 내보냅니다. dist/ 는 아래 build 명령이 만듭니다.
  "build": { "command": "node cloudflare/build.mjs" },
  "assets": { "directory": "./dist" },

  // HTML 틀은 글자 그대로 불러와 서비스가 제목을 채워 내보냅니다.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // 데이터(SQLite)를 가진 Durable Object 하나가 서비스 전체를 돌립니다. 무료 요금제에서 쓸 수 있습니다.
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "SubmitLink" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SubmitLink"] }],

  "workers_dev": true,
  "preview_urls": false,
  // 대시보드에서 넣은 변수(ADMIN_PASSWORD 등)를 다음 배포 때 지우지 않습니다.
  "keep_vars": true,
  "observability": { "enabled": true }
}
